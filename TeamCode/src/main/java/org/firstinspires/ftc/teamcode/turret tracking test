    private static final double TURN_GAIN = 0.03;
    private static final double STRAFE_GAIN = 0.025;
    private static final double DRIVE_GAIN = 0.02;
    
    // Rotation to target gains
    private static final double ROTATION_GAIN = 0.015;
    private static final double ROTATION_TOLERANCE = 2.0; // degrees
    
    // Alignment tolerances
    private static final double TOLERANCE_YAW = 1.5;
    private static final double TOLERANCE_X = 1.0;
    private static final double TOLERANCE_DISTANCE = 1.5;
    
    // Yellow object tracking gains
    private static final double YELLOW_TURN_GAIN = 0.02;
    private static final double YELLOW_STRAFE_GAIN = 0.015;
    
    // Optimal shooting parameters
    private static final double OPTIMAL_SHOOTING_DISTANCE = 24.0;
    private static final double MIN_SHOOTING_DISTANCE = 18.0;
    private static final double MAX_SHOOTING_DISTANCE = 48.0;

